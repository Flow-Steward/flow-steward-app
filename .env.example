# Flow Steward Local Development Environment
# Quick start:
#   cp .env.example .env
#
# Optional overlays:
#   cat .env.example.test >> .env
#   cat .env.example.quality >> .env
#   cat .env.example.ops >> .env

# --- Deployment environment ---
# Development quickstart; without it the app reads silence as production (AC17-R129).
FS_STACK_ENVIRONMENT=development

# --- Core runtime / target project ---
FS_DB_DSN=dbname=flow_steward user=flow_steward password=flow-steward-pass host=pg-fs port=5432
FS_OBSERVABILITY_DSN=
TARGET_PROJECT_PATH=/absolute/path/to/your/project
APP_PORT=8099

# --- Memory retrieval backends ---
FS_MEMORY_PROFILE=postgres_unified
FS_MEMORY_REPOSITORY_BACKEND=postgres
FS_MEMORY_KNOWLEDGE_BACKEND=postgres
FS_MEMORY_TEXT_SEARCH_BACKEND=postgres_fts
FS_MEMORY_VECTOR_BACKEND=postgres_pgvector
FS_CONTEXT_GRAPH_BACKEND=postgres_age
FS_PGVECTOR_DSN=
# Base compose already builds the canonical Postgres image with Apache AGE + pgvector.

# --- Attachment / payload redaction policy (required defaults for supported bootstraps) ---
FS_ATTACHMENT_MAX_SIZE_BYTES=20971520
FS_ATTACHMENT_MAX_FILES=10
FS_ALLOWED_ATTACHMENT_MIMES=image/png,image/jpeg,image/webp,image/gif,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,text/csv,application/octet-stream
FS_ALLOWED_ATTACHMENT_EXTENSIONS=.png,.jpg,.jpeg,.webp,.gif,.pdf,.xlsx,.xls,.docx,.txt,.md,.csv
FS_EXTENSION_DEBUG_PAYLOADS=0
FS_EXTENSION_PAYLOAD_REDACT_KEYS=password,secret,token,api_key,apikey,api_secret,access_token,refresh_token,authorization,credential,private_key,client_secret,webhook_secret,signing_key
FS_EXTENSION_PAYLOAD_REDACT_EXACT_KEYS=db_dsn,dsn,project_connections,project_providers,watch,watch_config,config,raw_config,secret_refs,credentials,auth,callback_url
FS_EXTENSION_PAYLOAD_REDACT_KEY_FRAGMENTS=secret,token,password,api_key,credential,dsn,connection,watch
FS_EXTENSION_PAYLOAD_REDACT_MAX_DEPTH=8
FS_EXTENSION_PAYLOAD_STRING_TRUNCATE_LENGTH=500
FS_TRACE_REDACT_MAX_LENGTH=1000

# --- LLM providers (at least one required) ---
FS_DEFAULT_PROVIDER=
FS_DEFAULT_MODEL=
FS_DEFAULT_TEMPERATURE=0.1

# --- Workflow discovery ---
# Keep this at 0 to require the workflow graph/vector backend. Set to 1 only
# as an emergency escape hatch if you explicitly want lexical-only degradation.
FS_WORKFLOW_DISCOVERY_LEXICAL_FALLBACK_ENABLED=0

# --- Auth (local dev defaults) ---
FS_LOCAL_AUTH_ENABLED=1
FS_SECRET_KEY=local-dev-secret-not-for-production
# Generate once for this env file before first start:
#   ./install.sh generates and preserves this value during first installation.
ENCRYPTION_KEY=
FS_BACKUP_ENCRYPTION_KEY=
FS_AUTH_COOKIE_SECURE=0
FS_AUTH_BOOTSTRAP_ENABLED=1
FS_AUTH_BOOTSTRAP_LOCALHOST_ONLY=1
FS_AUTH_BOOTSTRAP_TOKEN=
FS_AUTH_BOOTSTRAP_TOKEN_EXPIRES_AT=

# --- Local agent tooling (optional) ---
FS_FRONTEND_BUILD_IMAGE=node:22-bookworm-slim
MCP_BEARER_TOKEN=
# Installer-managed worker machine token. Leave empty: install.sh provisions an
# account-wide projects.read credential and rotates invalid credentials safely.
FS_WORKER_MCP_BEARER_TOKEN=

FS_OPENAPI_PUBLIC_ENABLED=0
FS_DOCS_PUBLIC_ENABLED=0
FS_OPENAPI_INTERNAL_ENABLED=0
FS_DOCS_INTERNAL_ENABLED=0
FS_OPENAPI_PUBLIC_REQUIRE_AUTH=1
FS_OPENAPI_INTERNAL_REQUIRE_AUTH=1

# --- DoS / request size limits (bytes; read once at startup, clamped to a safe range) ---
# Invalid, negative, or out-of-range values fall back to the default / clamp to range.
# Max bytes of stdout/stderr captured from a local extension subprocess before the
# child is killed (range 65536 .. 268435456).
FS_EXTENSION_OUTPUT_MAX_BYTES=5242880
# Shared effective limit for opted-in extension artifact producer/consumer policies
# (default 200 MiB; range 1 MiB .. 10 GiB).
FS_EXTENSION_ARTIFACT_MAX_BYTES=209715200
# Wall-clock deadline for opted-in long-running extension operations (seconds).
FS_EXTENSION_OPERATION_TIMEOUT_SECONDS=300
# Tabular-feed ceilings are operator-owned for self-hosted deployments. Defaults
# accept up to 2,000,000 rows / 1 GiB; raise deliberately for larger catalogs.
FS_FEED_MAX_ROWS=2000000
FS_FEED_MAX_BYTES=1073741824
FS_TABULAR_FEED_MAX_MATERIALIZE_BYTES=134217728
FS_TABULAR_FEED_READ_ROWS_SCAN_MAX_ROWS=100000
FS_TABULAR_FEED_READ_ROWS_SCAN_MAX_BYTES=67108864
# Extension dependency fetch mode. Default off requires bundled wheels; allowlist
# permits install-time downloads from the platform allowlisted PyPI index only.
FS_EXTENSION_DEPS_FETCH=off
# Max bytes allowed for one extension version's materialized Python site dir
# (range 1048576 .. 10737418240).
FS_EXTENSION_DEPS_SITE_MAX_BYTES=524288000
# Trusted local/dev override only. When 0, extension artifact grants refuse
# local_fs file:// URLs because the filesystem cannot enforce read/write methods.
FS_EXTENSION_TRUSTED_LOCAL_FS_ARTIFACT_GRANTS=0
# Max body size accepted on public extension callback webhooks (range 4096 .. 67108864).
FS_EXTENSION_CALLBACK_BODY_MAX_BYTES=1048576
# Max body size accepted on the generic provider webhook intake (range 4096 .. 67108864).
FS_PROVIDER_WEBHOOK_BODY_MAX_BYTES=1048576
# Max remote-runtime HTTPS response body read before JSON parse (range 65536 .. 268435456).
FS_REMOTE_RUNTIME_RESPONSE_MAX_BYTES=5242880
# Largest file the "Save file from base64" workflow step writes; a step may set less
# (range 1024 .. 1073741824).
FS_BASE64_FILE_MAX_BYTES=52428800
# Largest test file attached to a workflow file input for test runs (range 1024 .. 1073741824).
FS_WORKFLOW_TEST_FILE_MAX_BYTES=52428800
# Largest generated image or PDF previewed inline in Job Details (range 1024 .. 268435456).
FS_FILE_PREVIEW_MAX_BYTES=20971520
# Concurrent multipart task preparations admitted per application process (range 1 .. 64).
FS_TASK_UPLOAD_MAX_CONCURRENT_PREPARATIONS=4
# Concurrent multipart preparations admitted per account in one process (range 1 .. total).
FS_TASK_UPLOAD_MAX_CONCURRENT_PREPARATIONS_PER_ACCOUNT=2
# Concurrent multipart preparations admitted per authenticated principal in one process.
FS_TASK_UPLOAD_MAX_CONCURRENT_PREPARATIONS_PER_PRINCIPAL=2
# Maximum wall-clock seconds allowed to receive and parse one multipart request body.
FS_TASK_UPLOAD_BODY_READ_TIMEOUT_SECONDS=120
# Concurrent public job-SSE streams allowed per authenticated principal in one
# application process (range 1 .. 1000). This is a process-local guard.
FS_PUBLIC_SSE_MAX_CONNECTIONS_PER_PRINCIPAL=10
# Concurrent public job-SSE streams allowed per account in one application
# process (range 1 .. 10000). This is a process-local guard.
FS_PUBLIC_SSE_MAX_CONNECTIONS_PER_ACCOUNT=100

# --- Read-only static catalogs (absolute HTTPS JSON index URLs; the official catalogs by default, empty disables) ---
# Workflow template catalog shown by the Create workflow "From catalog" path.
FS_WORKFLOW_TEMPLATE_CATALOG_URL=https://raw.githubusercontent.com/Flow-Steward/workflows/main/index.json
# Extension catalog shown by the Extensions Marketplace tab.
FS_EXTENSION_CATALOG_URL=https://raw.githubusercontent.com/Flow-Steward/extensions/main/index.json
FS_MCP_CATALOG_URL=https://raw.githubusercontent.com/Flow-Steward/mcps/main/index.json
# Managed platforms require one persisted installation UUID, never a per-boot UUID.
# Compose installations retain their journal-backed project identity instead.
FS_INSTALLATION_ID=
FS_MONITORING_EXPECTATIONS={}
# Generic configured dependencies; without protocol evidence they remain not_observed.
FS_MONITORING_DEPENDENCIES=[]

# Canonical Compose owns rabbitmq-fs:5672 on its project network.
# Standalone/remote broker clients default to tls; remote URLs must use verified amqps.
# Other supported contexts: audit-local (rabbitmq-audit:5672), loopback-local
# (explicit numeric loopback address and port). No arbitrary plaintext hosts.
FS_RABBITMQ_TRANSPORT_MODE=compose-local
