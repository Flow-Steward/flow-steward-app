# FS memory backend profile examples.
# Append one block to .env, then start with the matching Compose profile.

# Postgres default: canonical records + Apache AGE graph + Postgres FTS.
FS_MEMORY_PROFILE=postgres_unified
FS_MEMORY_REPOSITORY_BACKEND=postgres
FS_MEMORY_KNOWLEDGE_BACKEND=postgres
FS_MEMORY_TEXT_SEARCH_BACKEND=postgres_fts
FS_MEMORY_VECTOR_BACKEND=null
FS_CONTEXT_GRAPH_BACKEND=postgres_age

# Postgres extended: Apache AGE for graph traversal + pgvector for vector search.
# FS_MEMORY_PROFILE=postgres_unified
# FS_MEMORY_TEXT_SEARCH_BACKEND=postgres_fts
# FS_MEMORY_VECTOR_BACKEND=postgres_pgvector
# FS_CONTEXT_GRAPH_BACKEND=postgres_age
# POSTGRES_SHARED_PRELOAD_LIBRARIES=age,pg_stat_statements
# OPENAI_API_KEY=
# FS_PGVECTOR_DSN=
