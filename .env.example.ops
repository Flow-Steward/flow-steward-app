# Flow Steward Optional Runtime / Ops Overlay
# Append to .env or .env.prod only when you need these advanced knobs:
#   cat .env.example.ops >> .env
#   cat .env.example.ops >> .env.prod
#
# This file groups everything that is useful, but not required for first boot:
# email, Sentry webhook diagnostics, worker/control tuning, DB tuning,
# artifact storage, registry helpers, and security scanning.

# --- Optional integrations / provider webhooks ---
# Runtime component monitoring policy (independent current/history retention).
FS_MONITORING_INTERVAL_SECONDS=60
FS_MONITORING_STALE_SECONDS=180
FS_MONITORING_HISTORY_ENABLED=0
FS_MONITORING_CURRENT_RETENTION_DAYS=7
FS_MONITORING_HISTORY_RETENTION_DAYS=7
FS_MONITORING_CLEANUP_BATCH_SIZE=500
FS_MONITORING_QUEUE_MAX_MESSAGES=10000
FS_MONITORING_QUEUE_MAX_BYTES=16777216
FS_MONITORING_OPERATION_TIMEOUT_SECONDS=2

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=0
SENTRY_AUTO_ENABLING_INTEGRATIONS=0
SENTRY_RELEASE=
FS_OBSERVABILITY_DSN=

# --- Runtime logging (stderr + daily file sink) ---
FS_LOG_LEVEL=INFO
FS_LOG_FILE_LEVEL=INFO
FS_LOG_STDERR_LEVEL=INFO
FS_LOG_FORMAT=text
FS_LOG_FILE_ENABLED=1
FS_LOG_STDERR_ENABLED=1
FS_LOG_DIR=/app/logs
FS_LOG_FILE_BASENAME=platform
FS_SERVICE_NAME=platform
FS_LOG_RETENTION_DAYS=30
FS_LOG_CAPTURE_WARNINGS=1
FS_LOG_UTC=0
FS_PROCESS_METRICS_HOST=0.0.0.0
FS_WORKER_METRICS_PORT=9101
FS_CONTROL_METRICS_PORT=9102

# --- Optional auth extensions / limits ---
FS_AUTH_PASSWORD_ITERATIONS=260000
FS_AUTH_PASSWORD_MIN_LENGTH=10
FS_AUTH_COOKIE_NAME=fs_session
FS_AUTH_CSRF_COOKIE_NAME=fs_csrf
FS_AUTH_CSRF_HEADER_NAME=x-csrf-token
FS_AUTH_SESSION_TTL_HOURS=24
FS_AUTH_REMEMBER_SESSION_TTL_HOURS=720
FS_AUTH_LOGIN_RATE_WINDOW_SECONDS=300
FS_AUTH_LOGIN_MAX_ATTEMPTS=5
FS_AUTH_LOGIN_LOCKOUT_SECONDS=900
FS_AUTH_PASSWORD_RESET_ENABLED=1
FS_AUTH_PASSWORD_RESET_TTL_MINUTES=30
FS_AUTH_PASSWORD_RESET_RATE_WINDOW_SECONDS=300
FS_AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
FS_AUTH_PASSWORD_RESET_LOCKOUT_SECONDS=900
FS_AUTH_PASSWORD_RESET_DEBUG_REVEAL_TOKEN=0
FS_DEFAULT_ACCOUNT_ID=00000000-0000-0000-0000-000000000002
FS_METRICS_TOKEN=
# Immutable source revision exposed by /health for deployment verification.
FS_BUILD_SHA=
# Immutable role image IDs exposed for candidate verification.
FS_APP_IMAGE=
FS_WORKER_IMAGE=
FS_CONTROL_IMAGE=
FS_APP_IMAGE_DIGEST=
FS_WORKER_IMAGE_DIGEST=
FS_CONTROL_IMAGE_DIGEST=

# --- Curated OpenAPI / docs exposure ---
# Safe defaults stay off until you intentionally expose these endpoints.
FS_OPENAPI_PUBLIC_ENABLED=0
FS_DOCS_PUBLIC_ENABLED=0
FS_OPENAPI_INTERNAL_ENABLED=0
FS_DOCS_INTERNAL_ENABLED=0
FS_OPENAPI_PUBLIC_REQUIRE_AUTH=1
FS_OPENAPI_INTERNAL_REQUIRE_AUTH=1

# --- Registry helpers ---
FS_PROVIDER_ALLOWLIST=

# --- Runtime scaling ---
APP_WORKERS=1
FS_PROJECT_LEASE_TTL_SECONDS=45
FS_PROJECT_LEASE_HEARTBEAT_SECONDS=15
FS_AGENT_HEARTBEAT_SEC=10
FS_CANCEL_POLL_SEC=1
FS_AGENT_KILL_GRACE_SEC=2
FS_SCHEMA_COMPAT_MAX_ATTEMPTS=12
FS_SCHEMA_COMPAT_RETRY_DELAY_SECONDS=2.0
FS_SERVE_SSL=0
FS_INTERNAL_BASE_URL=
FS_EXTENSIONS_ROOT=/app/extensions
FS_EXTENSION_DEPS_FETCH=off
FS_EXTENSION_DEPS_SITE_MAX_BYTES=524288000
FS_EXTENSION_ARTIFACT_MAX_BYTES=209715200
FS_EXTENSION_OPERATION_TIMEOUT_SECONDS=300
FS_FEED_MAX_ROWS=2000000
FS_FEED_MAX_BYTES=1073741824
FS_TABULAR_FEED_MAX_MATERIALIZE_BYTES=134217728
FS_TABULAR_FEED_READ_ROWS_SCAN_MAX_ROWS=100000
FS_TABULAR_FEED_READ_ROWS_SCAN_MAX_BYTES=67108864
FS_EXTENSION_TRUSTED_LOCAL_FS_ARTIFACT_GRANTS=0
FS_ARTIFACT_GRANT_VERIFY_KEY=
FS_ARTIFACT_ROOT=
FS_LLM_REQUEST_TIMEOUT_SECONDS=
FS_READY_REQUIRE_WORKERS=0
FS_READY_MAX_PENDING_JOBS=1000
FS_READY_MAX_STALE_LEASES=0
FS_READY_LEASE_STALE_SECONDS=120
FS_READY_MAX_STUCK_JOBS=0
FS_WORKER_PROJECT_IDS=
FS_WORKER_DISCOVERY_INTERVAL=10
FS_WORKER_RESTART_DELAY=2
FS_WORKER_SHUTDOWN_TIMEOUT=20
FS_STUCK_JOB_SECONDS=180
FS_EXTENSION_INBOUND_POLL_ENABLED=1
FS_ALLOW_PRIVATE_REMOTE_URLS=0
# Opt-in hardening (default 0): require payload-routed provider webhooks to present
# a per-project webhook secret; reject routing projects that have none (FS-DEEP-CAND-069).
FS_PROVIDER_WEBHOOK_REQUIRE_PROJECT_SECRET=0
FS_INVOKE_CHILD_TIMEOUT_SECONDS=5400
FS_INVOKE_CHILD_TIMEOUT_CAP_SECONDS=7200
FS_INVOKE_CHILD_POLL_SECONDS=2
# Maximum nested invoke_workflow depth in one chain; a deeper chain fails closed.
FS_INVOKE_WORKFLOW_MAX_DEPTH=5
# The one limit N on collections a run handles: rows one dataset_query may
# materialise into workflow state, and items one For each pass walks (a longer
# source is cut to the first N and the run reports the truncation). Both are held
# in state for the rest of the run, so raising this (5000, 10000) costs source
# database load, worker memory and checkpoint size in equal measure. For larger
# volumes, prepare an export on the source side (URL, FTP/SFTP, upload or email)
# and read the file instead.
FS_DATASET_QUERY_MAX_RUNTIME_ROWS=1000
FS_INVOKE_CHILD_CANCEL_ON_TIMEOUT=1
FS_INVOKE_INLINE_EXECUTION=1
FS_RESTORE_PARITY_DSN=

# --- Optional local hot reload ---
# Enable the React/Vite dev server, Tailwind watcher, and backend autoreload
# when you want the main compose file to behave like a local dev stack.
FS_COMPOSE_PROJECT_NAME=flow-steward
FS_AUTO_RELOAD=0
FS_MCP_AUTH_DISABLED=0
VITE_PORT=5173
VITE_USE_POLLING=1
VITE_POLL_INTERVAL=150

# --- Control-plane loops ---
# Compose ownership:
# - app container sets CONTROL_LOOPS_ENABLED=0
# - control-plane sets CONTROL_LOOPS_ENABLED=1
CONTROL_LOOPS_ENABLED=0
FS_ARTIFACT_CLEANUP_RECONCILIATION_BUDGET=16
FS_WATCHDOG_ENABLED=1
FS_WATCHDOG_INTERVAL_SECONDS=30
FS_WATCHDOG_AUTO_APPLY=1
FS_WATCHDOG_STUCK_SECONDS=120
FS_WATCHDOG_ORPHAN_GRACE_SECONDS=120
FS_WATCHDOG_PICKUP_GRACE_SECONDS=45
FS_WATCHDOG_MAX_JOURNAL_ENTRIES=200
FS_EXTERNAL_EFFECT_MAINTENANCE_ENABLED=1
FS_EXTERNAL_EFFECT_MAINTENANCE_INTERVAL_SECONDS=300
FS_SCHEDULED_JOBS_ENABLED=1
FS_SCHEDULED_JOBS_INTERVAL_SECONDS=30
FS_SCHEDULED_JOBS_BATCH_LIMIT=20
FS_DASHBOARD_ROLLUP_ENABLED=1
FS_DASHBOARD_ROLLUP_INTERVAL_SECONDS=300
FS_DASHBOARD_ROLLUP_BACKFILL_DAYS=180
FS_DASHBOARD_ROLLUP_LOOKBACK_DAYS=3
FS_DASHBOARD_ROLLUP_READ_ENABLED=1
FS_RETENTION_LOGS_DAYS=30
FS_RETENTION_MESSAGES_DAYS=30
FS_RETENTION_TRASH_DAYS=30
FS_RETENTION_JOBS_DAYS=30
FS_RETENTION_EVENTS_DAYS=30
FS_RETENTION_RETRY_QUEUE_DAYS=14
FS_RETENTION_REVISIONS_KEEP=5
# Process-local caps for public job SSE streams. Enforce global connection
# quotas at the load balancer or a shared limiter when running multiple app pods.
FS_PUBLIC_SSE_MAX_CONNECTIONS_PER_PRINCIPAL=10
FS_PUBLIC_SSE_MAX_CONNECTIONS_PER_ACCOUNT=100

# --- Postgres tuning / diagnostics ---
FS_DB_POOL_ENABLED=1
FS_DB_POOL_MIN=1
FS_DB_POOL_MAX=8
FS_DB_POOL_WAIT_TIMEOUT=1.0
POSTGRES_COMPUTE_QUERY_ID=auto
POSTGRES_SHARED_PRELOAD_LIBRARIES=pg_stat_statements
POSTGRES_SESSION_PRELOAD_LIBRARIES=auto_explain
POSTGRES_LOG_MIN_DURATION_STATEMENT=500ms
POSTGRES_LOG_LINE_PREFIX=%m [%p] db=%d,user=%u,app=%a,client=%h
POSTGRES_LOG_LOCK_WAITS=on
POSTGRES_DEADLOCK_TIMEOUT=200ms
POSTGRES_TRACK_IO_TIMING=on
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_COMPRESSION=on
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_MIN_WAL_SIZE=1GB
POSTGRES_DEFAULT_STATISTICS_TARGET=200
POSTGRES_JIT=off
POSTGRES_PG_STAT_STATEMENTS_TRACK=all
POSTGRES_PG_STAT_STATEMENTS_MAX=10000
POSTGRES_AUTO_EXPLAIN_LOG_MIN_DURATION=500ms
POSTGRES_AUTO_EXPLAIN_LOG_ANALYZE=on
POSTGRES_AUTO_EXPLAIN_LOG_BUFFERS=on
POSTGRES_AUTO_EXPLAIN_LOG_TIMING=on
POSTGRES_AUTO_EXPLAIN_LOG_NESTED_STATEMENTS=on
POSTGRES_AUTO_EXPLAIN_SAMPLE_RATE=1.0

# --- Security scanning ---
SECURITY_SCAN_MODE=monitor
SECURITY_FAIL_CLOSED_ON_POLICY_ERROR=0
SECURITY_PII_SALT=change-me

# --- Artifact storage ---
# For bundled SeaweedFS, prefer `./install.sh --file-storage bundled`: it owns
# the endpoint and generates the matching owner-only identity and credentials.
# The values below are primarily for an explicitly selected external S3 service.
ARTIFACT_STORAGE_BACKEND=s3
ARTIFACT_S3_ENDPOINT_URL=
# Optional browser-reachable S3 endpoint used only to sign direct UI downloads.
# Leave empty when ARTIFACT_S3_ENDPOINT_URL is already browser reachable.
ARTIFACT_S3_PUBLIC_ENDPOINT_URL=
ARTIFACT_S3_BUCKET=platform-artifacts
ARTIFACT_S3_ACCESS_KEY=
ARTIFACT_S3_SECRET_KEY=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_KEY_PREFIX=
ARTIFACT_S3_USE_SSL=true
ARTIFACT_S3_PRESIGN_TTL_SECONDS=600
ARTIFACT_LOCAL_ROOT_DIR=/data/artifacts
