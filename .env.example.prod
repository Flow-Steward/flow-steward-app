# Flow Steward Production Environment
# Quick start:
#   cp .env.example.prod .env.prod
#
# Optional overlays:
#   cat .env.example.ops >> .env.prod
#
# Keep this file minimal: only the values needed to boot the production stack.

# --- Public runtime ---
# Managed platforms: provision one UUID before first start and retain it across upgrades.
# Installed Compose stacks use their existing durable journal-backed project identity.
FS_INSTALLATION_ID=
# Optional generic role counts: {"worker":3,"image-indexer":null}; lifecycle projects Compose expectations.
FS_MONITORING_EXPECTATIONS={}
# Optional generic dependency names; lifecycle projects Compose's configured choices.
FS_MONITORING_DEPENDENCIES=[]
APP_PORT=8099
HTTP_PORT=8080
FS_DB_DSN=dbname=flow_steward user=flow_steward password=CHANGE_ME_STRONG_PASSWORD host=pg-fs port=5432
FS_OBSERVABILITY_DSN=
FS_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN
# Immutable source revision baked into the release image; set by CI build.
FS_BUILD_SHA=
# Immutable role image IDs deployed from the CI candidate artifacts.
FS_APP_IMAGE=
FS_WORKER_IMAGE=
FS_CONTROL_IMAGE=
FS_APP_IMAGE_DIGEST=
FS_WORKER_IMAGE_DIGEST=
FS_CONTROL_IMAGE_DIGEST=
LANGGRAPH_POSTGRES_URI=postgresql://flow_steward:CHANGE_ME_STRONG_PASSWORD@pg-fs:5432/flow_steward
RABBITMQ_URL=amqp://flow_steward:CHANGE_ME_STRONG_PASSWORD@rabbitmq-fs:5672/
MCP_URL=http://fs-mcp:8100/mcp
# Machine token issued to a worker-only service account with projects.read.
# Replaced by install.sh with an owner-only account-wide projects.read token.
FS_WORKER_MCP_BEARER_TOKEN=CHANGE_ME_WORKER_MACHINE_TOKEN

# --- Memory retrieval backends ---
FS_MEMORY_PROFILE=postgres_unified
FS_MEMORY_REPOSITORY_BACKEND=postgres
FS_MEMORY_KNOWLEDGE_BACKEND=postgres
FS_MEMORY_TEXT_SEARCH_BACKEND=postgres_fts
FS_MEMORY_VECTOR_BACKEND=postgres_pgvector
FS_CONTEXT_GRAPH_BACKEND=postgres_age
FS_PGVECTOR_DSN=

# --- Attachment / payload redaction policy (required defaults for supported bootstraps) ---
FS_ATTACHMENT_MAX_SIZE_BYTES=20971520
FS_ATTACHMENT_MAX_FILES=10
FS_ALLOWED_ATTACHMENT_MIMES=image/png,image/jpeg,image/webp,image/gif,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,text/csv,application/octet-stream
FS_ALLOWED_ATTACHMENT_EXTENSIONS=.png,.jpg,.jpeg,.webp,.gif,.pdf,.xlsx,.xls,.docx,.txt,.md,.csv
FS_EXTENSION_DEBUG_PAYLOADS=0
FS_EXTENSION_PAYLOAD_REDACT_KEYS=password,secret,token,api_key,apikey,api_secret,access_token,refresh_token,authorization,credential,private_key,client_secret,webhook_secret,signing_key
FS_EXTENSION_PAYLOAD_REDACT_EXACT_KEYS=db_dsn,dsn,project_connections,project_providers,watch,watch_config,config,raw_config,secret_refs,credentials,auth,callback_url
FS_EXTENSION_PAYLOAD_REDACT_KEY_FRAGMENTS=secret,token,password,api_key,credential,dsn,connection,watch
FS_EXTENSION_PAYLOAD_REDACT_MAX_DEPTH=8
FS_EXTENSION_PAYLOAD_STRING_TRUNCATE_LENGTH=500
FS_TRACE_REDACT_MAX_LENGTH=1000

# --- LLM providers (at least one required) ---
FS_DEFAULT_PROVIDER=
FS_DEFAULT_MODEL=
FS_DEFAULT_TEMPERATURE=0.1

# --- Workflow discovery ---
# Keep this at 0 in normal operation so workflow discovery fails loudly if the
# workflow graph/vector backend is unavailable instead of silently degrading.
FS_WORKFLOW_DISCOVERY_LEXICAL_FALLBACK_ENABLED=0

# --- Auth / public origin ---
FS_SECRET_KEY=CHANGE_ME_32_PLUS_CHARACTERS
# Generate once before first start and keep stable across restarts:
#   ./install.sh generates and preserves this value during first installation.
ENCRYPTION_KEY=
FS_BACKUP_ENCRYPTION_KEY=
# Salt for deterministic PII pseudonymisation; every agent workflow fails at run time without it.
#   ./install.sh generates and preserves this value during first installation.
SECURITY_PII_SALT=
FS_PUBLIC_BASE_URL=https://flowsteward.example.com
FS_AUTH_TRUSTED_ORIGINS=https://flowsteward.example.com
FS_LOCAL_AUTH_ENABLED=1
FS_AUTH_COOKIE_SECURE=1
FS_AUTH_BOOTSTRAP_ENABLED=0
FS_AUTH_BOOTSTRAP_LOCALHOST_ONLY=1
FS_AUTH_BOOTSTRAP_TOKEN=CHANGE_ME_BOOTSTRAP_TOKEN
FS_AUTH_BOOTSTRAP_TOKEN_EXPIRES_AT=

# --- Curated OpenAPI / docs exposure (safe defaults stay off) ---
FS_OPENAPI_PUBLIC_ENABLED=0
FS_DOCS_PUBLIC_ENABLED=0
FS_OPENAPI_INTERNAL_ENABLED=0
FS_DOCS_INTERNAL_ENABLED=0
FS_OPENAPI_PUBLIC_REQUIRE_AUTH=1
FS_OPENAPI_INTERNAL_REQUIRE_AUTH=1

# --- Databases / queues ---
POSTGRES_DB=flow_steward
POSTGRES_USER=flow_steward
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_USER=flow_steward
RABBITMQ_PASS=CHANGE_ME_STRONG_PASSWORD

# --- Host-visible mutable state ---
# These paths are intentionally outside the versioned image so Docker-first
# upgrades preserve operator data.
FS_EXTENSIONS_DIR=../../extensions
FS_LOGS_DIR=../../logs
FS_BACKUPS_DIR=../../backups
FS_DB_SCHEMA_DIR=../../db/schema
FS_EXTENSION_DEPS_FETCH=off
FS_EXTENSION_DEPS_SITE_MAX_BYTES=524288000
FS_EXTENSION_ARTIFACT_MAX_BYTES=209715200
FS_EXTENSION_OPERATION_TIMEOUT_SECONDS=300
FS_FEED_MAX_ROWS=2000000
FS_FEED_MAX_BYTES=1073741824
FS_TABULAR_FEED_MAX_MATERIALIZE_BYTES=134217728
FS_TABULAR_FEED_READ_ROWS_SCAN_MAX_ROWS=100000
FS_TABULAR_FEED_READ_ROWS_SCAN_MAX_BYTES=67108864
FS_EXTENSION_TRUSTED_LOCAL_FS_ARTIFACT_GRANTS=0

# --- Official release discovery and third-party infrastructure pins ---
FS_RELEASE_REPOSITORY=Flow-Steward/flow-steward-app
FS_RELEASE_REGISTRIES=ghcr.io/flow-steward,docker.io/flowsteward
TRAEFIK_IMAGE=traefik:v3.3
# Release upgrades replace this with either a digest-qualified published image
# or a versioned source-build tag. Do not use a floating pg17/latest tag.
POSTGRES_IMAGE=fs-postgres-extended:0.1.0-pgvector-0.8.5
RABBITMQ_IMAGE=rabbitmq:3.13-management

# --- Read-only static catalogs (absolute HTTPS JSON index URLs; the official catalogs by default, empty disables) ---
# Workflow template catalog shown by the Create workflow "From catalog" path.
FS_WORKFLOW_TEMPLATE_CATALOG_URL=https://raw.githubusercontent.com/Flow-Steward/workflows/main/index.json
# Extension catalog shown by the Extensions Marketplace tab.
FS_EXTENSION_CATALOG_URL=https://raw.githubusercontent.com/Flow-Steward/extensions/main/index.json
FS_MCP_CATALOG_URL=https://raw.githubusercontent.com/Flow-Steward/mcps/main/index.json

# Canonical Compose owns rabbitmq-fs:5672 on its project network.
# Standalone/remote broker clients default to tls; remote URLs must use verified amqps.
# Other supported contexts: audit-local (rabbitmq-audit:5672), loopback-local
# (explicit numeric loopback address and port). No arbitrary plaintext hosts.
FS_RABBITMQ_TRANSPORT_MODE=compose-local
