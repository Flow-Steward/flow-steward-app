# Flow Steward Quality / SonarQube Overlay
# Append to .env only when you intentionally run SonarQube tooling:
#   cat .env.example.quality >> .env

# --- SonarQube (optional quality profile) ---
SONAR_IMAGE=sonarqube:community
SONAR_SCANNER_IMAGE=sonarsource/sonar-scanner-cli@sha256:23ca0f137965d9dff2198074043fd48d386280bc5d0ccac8c8349cea4cf096a9
SONAR_PORT=9000
SONAR_HOST_URL=http://sonarqube:9000
SONAR_WAIT_URL=http://localhost:9000
SONAR_TOKEN=
SONAR_PROJECT_KEY=flow-steward-project
SONAR_PROJECT_NAME=Flow Steward Project
SONAR_PROJECT_KEY_JS=flow-steward-project-js
SONAR_PROJECT_NAME_JS=Flow Steward Project (JS)
SONAR_QUALITYGATE_WAIT=true
SONAR_QUALITYGATE_TIMEOUT=300
SONAR_SCANNER_JAVA_OPTS=-Xmx2g
SONAR_MEM_LIMIT=6g
SONAR_SCANNER_MEM_LIMIT=6g
SONAR_WEB_JAVAOPTS=-Xms512m -Xmx1024m
SONAR_CE_JAVAOPTS=-Xms512m -Xmx2048m
SONAR_SEARCH_JAVAOPTS=-Xms512m -Xmx1024m
SONAR_MEM_LIMIT_FULL=6g
SONAR_SCANNER_MEM_LIMIT_FULL=8g
SONAR_SCANNER_JAVA_OPTS_FULL=-Xmx1g
SONAR_WEB_JAVAOPTS_FULL=-Xms512m -Xmx1024m
SONAR_CE_JAVAOPTS_FULL=-Xms512m -Xmx2048m
SONAR_SEARCH_JAVAOPTS_FULL=-Xms512m -Xmx1024m
SONAR_LOCAL=1
SONAR_PROFILE=stable
SONAR_ENABLED=0
SONAR_EXPORT=0
SONAR_EXPORT_DIR=logs/quality/sonar
SONAR_BACKLOG=0
SONAR_BACKLOG_PATH=logs/quality/sonar/sonar-dev-backlog.md
SONAR_BACKLOG_INPUT_CSV=
SONAR_BACKLOG_TOP_RULES=15
SONAR_BACKLOG_TOP_FILES=20
SONAR_BACKLOG_MAX_P0=60
SONAR_BACKLOG_MAX_P1=40
SONAR_ISSUES_STATUSES=OPEN,CONFIRMED,REOPENED
SONAR_ISSUES_SEVERITIES=
SONAR_ISSUES_TYPES=
SONAR_ISSUES_PAGE_SIZE=500
SONAR_MIN_FILE_LINES=
SONAR_MAX_FILE_LINES=

# --- Optional audit/lint tuning ---
FS_COV_FAIL_UNDER=0
FS_SEMGREP_TIMEOUT=30
FS_SEMGREP_TIMEOUT_THRESHOLD=25
FS_SEMGREP_JOBS=4
FS_ZAP_TARGET_URL=
FS_ZAP_MAX_MINUTES=5
FS_BANDIT_BASELINE_FILE=infra/tooling/quality/bandit-baseline-medium-high.json
FS_SEMGREP_PYTHONWARNINGS=ignore::SyntaxWarning:glom.matching
FS_VULTURE_MIN_CONFIDENCE=90
FS_PYLINT_DUPLICATE_MIN_LINES=12
FS_XENON_MAX_ABSOLUTE=F
FS_XENON_MAX_MODULES=C
FS_XENON_MAX_AVERAGE=B
