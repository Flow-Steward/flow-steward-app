# Flow Steward Test / E2E / Nightfire Overlay
# Append to .env only when you need UI/E2E/test-runner workflows:
#   cat .env.example.test >> .env

# --- Base URLs / runner ---
APP_BASE_URL=https://localhost:8099
TEST_RUNNER_BASE_URL=http://fs-app:8099
E2E_VERIFY_SSL=0

# --- Test projects ---
TEST_PROJECT_UI_NAME=Test Project UI
TEST_PROJECT_UI_ID=
TEST_PROJECT_BACKEND_NAME=Test Project Backend
TEST_PROJECT_BACKEND_ID=

# --- Seeded local users ---
E2E_ADMIN_USERNAME=e2e_admin@example.com
E2E_ADMIN_PASSWORD=e2e_admin_password_123!
E2E_ADMIN_DISPLAY_NAME=E2E Admin
E2E_OPERATOR_USERNAME=e2e_operator@example.com
E2E_OPERATOR_PASSWORD=e2e_operator_password_123!
E2E_OPERATOR_DISPLAY_NAME=E2E Operator
E2E_VIEWER_USERNAME=e2e_viewer@example.com
E2E_VIEWER_PASSWORD=e2e_viewer_password_123!
E2E_VIEWER_DISPLAY_NAME=E2E Viewer

# --- Lane defaults ---
E2E_UI_ROLE=admin
E2E_BACKEND_ROLE=admin
NIGHTFIRE_LANE=ui
NIGHTFIRE_AUTH_ROLE=admin
NIGHTFIRE_SOURCE_WORKFLOW_ID=
NIGHTFIRE_FULL_UI=0

# --- Optional targeted E2E knobs ---
E2E_REPLAY_EXECUTE=0
E2E_RETRYABLE_JOB_ID=
E2E_PARENT_BRANCH=
