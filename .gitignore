# Ops runtime artifacts (coverage/quality/test-runs/tool-cache all live here)
logs/
# Generated locally by audits and experiments; never committed
audit-artifacts/
# Internal task/review history is not distributable project documentation.
/docs/audits/
/docs/backlog/
/docs/reviews/
/docs/tasks/
/docs/superpowers/
/docs/product/
examples/
tmp/workflow_audit_repo/
