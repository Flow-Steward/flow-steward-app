# AI Builder / audit diagnostic reports generated during local verification
scripts/ai_builder_eval_report*.md
scripts/ai_builder_eval_report*.json
audit*.md
audit*.json
myaudit*.md
myaudit*.json

# Backup / scratch files
*.bak
*.backup
*.swp
*.tmp
.tmp_*

# Generated Tailwind output (built by Dockerfile; not committed)
assets/tailwind.css

# Frontend uses npm/package-lock.json; do not add a second package-manager lockfile.
assets/frontend/pnpm-lock.yaml

# Python build metadata (generated by pip install -e)
*.egg-info/
