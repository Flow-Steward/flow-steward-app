http:
  routers:
    readiness:
      entryPoints:
        - compact
      rule: "Path(`/health/ready`)"
      priority: 110
      service: health
      middlewares:
        - strip-mcp-forward
    mcp:
      entryPoints:
        - compact
      # AC17-R56: the protected-resource metadata the 401 advertises is served by the MCP
      # process, not the app, and RFC 9728 puts it outside /mcp — the SDK registers it at
      # /.well-known/oauth-protected-resource + the resource path. Without this prefix the
      # advertised document fell through to the app, which has no such route, so every
      # discovery attempt 404'd. Deliberately narrow: /.well-known/oauth-authorization-server
      # belongs to the issuer, which is the app, and is not matched here.
      rule: "Path(`/mcp`) || PathPrefix(`/mcp/`) || PathPrefix(`/.well-known/oauth-protected-resource`)"
      priority: 100
      service: mcp
      middlewares:
        - strip-mcp-forward
    app:
      entryPoints:
        - compact
      rule: "PathPrefix(`/`)"
      priority: 10
      service: app
      middlewares:
        - strip-mcp-forward
  middlewares:
    # ADR 0047 decision 13, defence in depth: X-Flow-Steward-Mcp-Forward is sent only by
    # the mcp role to the app role over loopback. Every public router removes an inbound
    # copy (an empty custom request header deletes it); the shared secret is the control.
    strip-mcp-forward:
      headers:
        customRequestHeaders:
          X-Flow-Steward-Mcp-Forward: ""
  services:
    app:
      loadBalancer:
        passHostHeader: true
        responseForwarding:
          flushInterval: -1ms
        servers:
          - url: "$app_origin"
    mcp:
      loadBalancer:
        passHostHeader: true
        responseForwarding:
          flushInterval: -1ms
        servers:
          - url: "$mcp_origin"
    health:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://127.0.0.1:9100"
